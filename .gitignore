# ── Python runtime ───────────────────────────────────────────────────────────
*.pyc
*.pyo
*.pyd
**/__pycache__/
*.egg-info/
.eggs/
*.so

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
.env/
ENV/
env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
configs/llm.json

# ── Test & coverage runtime ───────────────────────────────────────────────────
.pytest_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temp & agent workspace ────────────────────────────────────────────────────
.tmp/
tmp/
temp/

# ── VS Code (keep settings and tasks) ────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ── Editor swap ───────────────────────────────────────────────────────────────
*.swp
*.swo
*.bak

# ── Nested hooks artifact (rsync side-effect) ────────────────────────────────
hooks/hooks/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo
.eslintcache
.vite/
