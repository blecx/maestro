# ── Python runtime ───────────────────────────────────────────────────────────
*.py[cod]
*$py.class
*.pyd
**/__pycache__/
*.egg-info/
.eggs/
*.so

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
.env/
ENV/
env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.maestro.example
*.pem
*.key
certs/
secrets/
configs/llm.json

# ── Project Docs ──────────────────────────────────────────────────────────────
projectDocs/

# ── Test & coverage runtime ───────────────────────────────────────────────────
.pytest_cache/
.tox/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
*.cover

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temp & agent workspace ────────────────────────────────────────────────────
.tmp/
tmp/
temp/

# ── VS Code (keep settings and tasks) ────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ── Editor swap ───────────────────────────────────────────────────────────────
*.swp
*.swo
*.bak

# ── Nested hooks artifact (rsync side-effect) ────────────────────────────────
hooks/hooks/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo
.eslintcache
.vite/
