# Maestro Framework Environment Variables
# Copy this file to .env and configure your keys to enable the AI toolchain

# Maestro version to pin when syncing into a host project (git tag or SHA).
# Run `make sync-maestro` to pull this version into your repo.
# Run `make check-maestro-version` to verify your local copy is up to date.
MAESTRO_VERSION=main

# LLM Providers (for Maestro Operator and Copilot Custom Models)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MCP Servers
CONTEXT7_API_KEY=your_context7_api_key_here

# Automation & DevOps
GITHUB_TOKEN=your_github_pat_here

# System Logging
MAESTRO_DEBUG=false
MAESTRO_LOG_LEVEL=info
